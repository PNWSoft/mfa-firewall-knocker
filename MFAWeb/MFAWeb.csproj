<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.9</Version>
    <BuildDate>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss"))</BuildDate>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>knocker.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="knocker.ico" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Fido2" Version="3.0.1" />
    <!-- These two are NOT used directly by our code. They are deliberate transitive version
         overrides. Fido2 3.0.1 resolves Microsoft.IdentityModel.* to 6.17.0, which carries
         GHSA-59j7-ghrg-fj52 (moderate severity). Pinning 6.34.0 lifts the graph out of the
         vulnerable range; deleting these references reintroduces the advisory, as verified
         by 'dotnet list package' with the vulnerable flag. NuGet marks the whole 6.x line
         Legacy, so this trades a deprecation notice for the absence of a known CVE, which
         is the right way round. The real fix is upgrading Fido2 to 4.x, which requires
         re-testing the passkey ceremonies and is tracked as a known issue.
         Do not remove these as "unused" without checking the vulnerable list first. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="6.34.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.34.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.5" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>


  <!-- Optional TOTP (authenticator app) support. OFF by default.
       TOTP is phishable and a captured code stays valid for ~90s, so an account with it
       enrolled is only as strong as that weaker method. Leaving it out of the build means
       there is no TOTP code path to misconfigure, disable incorrectly, or audit.
       Build with -p:AllowTotp=true to compile it in. The flag MUST match across all three
       components, which are deployed together anyway (shared users.dat schema). -->
  <PropertyGroup Condition="'$(AllowTotp)' == 'true'">
    <DefineConstants>$(DefineConstants);ALLOW_TOTP</DefineConstants>
  </PropertyGroup>

</Project>
