<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.0</Version>
    <BuildDate>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss"))</BuildDate>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>knocker.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="knocker.ico" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
    <InternalsVisibleTo Include="MFAService.RegressionTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.5" />
  </ItemGroup>


  <!-- Optional TOTP (authenticator app) support. OFF by default.
       TOTP is phishable and a captured code stays valid for ~90s, so an account with it
       enrolled is only as strong as that weaker method. Leaving it out of the build means
       there is no TOTP code path to misconfigure, disable incorrectly, or audit.
       Build with -p:AllowTotp=true to compile it in. The flag MUST match across all three
       components, which are deployed together anyway (shared users.dat schema). -->
  <PropertyGroup Condition="'$(AllowTotp)' == 'true'">
    <DefineConstants>$(DefineConstants);ALLOW_TOTP</DefineConstants>
  </PropertyGroup>

</Project>
