{
  "Logging": {
    "AppMinLevel": "Info"
  },
  "DpapiEntropy": "REPLACE-WITH-A-UNIQUE-RANDOM-STRING",
  "BouncerConfig": {
    "AllowedPorts": [ "22/TCP" ],
    // How long each granted rule lives. Match it to your users and use case: a short window
    // suits occasional admin access, a longer one suits developers on fixed machines who
    // authenticate once at the start of a long day. Clamped to 1-48 hours -- a value above 48
    // is treated as a typo, clamped, and logged, so a slipped digit cannot leave rules in the
    // firewall for weeks. Rules are swept within 5 minutes of expiring.
    "ExpirationHours": 1,
    "RulePrefix": "MFA_Temp_"
  },
  "FirewallService": {
    // Windows: the gMSA below. Linux: replace with the local web account, "mfaweb".
    // Missing/unresolvable identities block new grants while expiry sweeping continues.
    "GmsaAccount": "YOURDOMAIN\\MFA_Service$"
  },

  // Certificate-expiry monitoring: MFAService watches the Windows cert store for
  // the site's TLS cert and emails NotifyAddress when it is missing, expired, or
  // within WarnDays of expiring. HttpsCert must match MFAWeb's HttpsCert block.
  "HttpsCert": {
    // Windows: which certificate to watch in the store. Must match MFAWeb's HttpsCert.
    "Subject": "your.domain.com",
    "Store": "My",
    "Location": "LocalMachine",
    // Linux: there is no certificate store, so point at the PEM MFAWeb serves. Without this
    // there are NO expiry warnings on Linux -- and an expired certificate is a lockout, since
    // browsers refuse WebAuthn on an invalid certificate.
    "PemPath": "/etc/mfa-auth/tls/current/fullchain.pem"
  },
  "CertAlert": {
    "WarnDays": 20,
    "CheckIntervalHours": 12
  },
  "Smtp": {
    "Host": "your-smtp-server",
    "Port": 25,
    "UseSsl": false,
    "Username": "",
    "Password": "",
    "FromAddress": "security@your-domain.com",
    "NotifyAddress": "admins@your-domain.com"
  }
}
