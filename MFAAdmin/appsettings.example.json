{
  "Logging": {
    "AppMinLevel": "Info"
  },
  "AllowedDomains": [
    "your-domain.com"
  ],
  "SiteName": "My Organization",
  "RulePrefix": "MFA_Temp_",

  // Passkey-only mode. Default is TRUE. MUST match RequirePasskey in MFAWeb's
  // appsettings.json. When true, 'add' and 'reprovision' mint no TOTP secret and the
  // provisioning email omits the authenticator-app link.
  "RequirePasskey": true,

  "DpapiEntropy": "REPLACE-WITH-A-UNIQUE-RANDOM-STRING",
  "BouncerUrl": "https://your.domain.com:8443",
  "FirewallService": {
    "GmsaAccount": "YOURDOMAIN\\MFA_Service$"
  },
  "Smtp": {
    "Host": "your-smtp-server",
    "Port": 25,
    "UseSsl": false,
    "Username": "",
    "Password": "",
    "FromAddress": "security@your-domain.com",
    "NotifyAddress": "admins@your-domain.com"
  }
}
